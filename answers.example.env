# Answers for a non-interactive setup:
#   deploy/setup.sh --answers /secure/path/answers.env --yes
# Anything left out is asked (or defaulted with --yes). Keep the real file out of git
# (chmod 600). `deploy/setup.sh export-answers` writes one from a running server.
# Secrets are optional here: omitted passwords are generated and stored on the server.

PROJECT_SLUG=myapp
APP_HOME=/home/deploy/myapp

# Application
BACKEND_DIR=backend
FRONTEND_ENABLED=y             # n = API only
FRONTEND_DIR=frontend
API_PREFIX=/api/v1             # none = no prefix
RUNTIME=docker                 # docker | native
# BACKEND_DOCKERFILE=backend/Dockerfile  BACKEND_CONTEXT=backend
# FRONTEND_DOCKERFILE=frontend/Dockerfile FRONTEND_CONTEXT=.
# PHP_VERSION=8.3                        # RUNTIME=native: a PHP-FPM pool for the app is created

# Server OS family (default: detected): debian | rhel | suse | arch
# OS_FAMILY=debian

# Components
DB_ENGINE=pgsql                # pgsql | mysql
DB_MODE=docker                 # docker | native | external
# DB_VERSION=17                # major version; default from your CI/compose/DDEV files
REDIS_MODE=docker              # docker | native | external | none
STORAGE_MODE=minio-docker      # minio-docker | minio-native | s3 | local
QUEUE_WORKER=horizon           # horizon | worker | none
SCHEDULER_ENABLED=y            # y | n

# Deploy steps (blank = detected default)
# HEALTH_PATH=/up
POST_DEPLOY_ARTISAN=none       # e.g. "permission:sync; l5-swagger:generate"
# SEED_ADMIN_CMD="app:create-admin {email} {name}"   # used by setup.sh seed-admin
# FRONTEND_API_MODE=direct     # direct (CORS) | proxy (Next.js rewrites /api)
# QUEUE_WORK_ARGS="--sleep=3 --tries=3 --max-time=3600"   # QUEUE_WORKER=worker
# NODE_VERSION=24              # native runtime; default from .nvmrc
# PRODUCTION_FRONTEND_ENV="API_PROXY_TARGET=http://127.0.0.1:8100"   # per env, or none

# Edge
EDGE_MODE=certbot              # certbot | byo | panel
CERTBOT_EMAIL=ops@example.com
# TLS_CERT=/etc/ssl/example/fullchain.pem   # EDGE_MODE=byo
# TLS_KEY=/etc/ssl/example/privkey.pem
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
ROOT_DOMAIN=example.com        # only used to suggest hosts

ENABLED_ENVS="production"      # e.g. "production staging dev"
PRODUCTION_FRONTEND_HOST=example.com
PRODUCTION_API_HOST=api.example.com
PRODUCTION_BRANCH=main
# STAGING_FRONTEND_HOST=staging.example.com
# STAGING_API_HOST=api-staging.example.com
# STAGING_BRANCH=staging
MEDIA_HOST=media.example.com   # MinIO only; blank = no public media host

# Catalog variables: KEY=value applies to every env, <ENV>__KEY=value to one env.
APP_NAME="My App"
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_MAILER=smtp               # log | smtp | mailgun | postmark | resend
PRODUCTION__MAIL_HOST=smtp.example.com
PRODUCTION__MAIL_USERNAME=postmaster@example.com
SMS_DEFAULT_DRIVER=log         # log | twilio | ssl | http
PAYMENT_GATEWAYS=stripe        # any of stripe,paypal,sslcommerz,bkash,nagad (blank = none)
OAUTH_PROVIDERS=               # any of google,facebook,github

# Steps
DP_APPLY=y
DP_HARDEN=n
DEPLOY_NOW="production"

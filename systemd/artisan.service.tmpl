[Unit]
Description=__SLUG__ __DESC__ (__ENV__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__RUN__
ExecStart=__PHP__ artisan __CMD__
Restart=always
RestartSec=5
# Let a worker finish its current job on stop/restart.
KillSignal=SIGTERM
TimeoutStopSec=70
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

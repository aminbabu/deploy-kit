[Unit]
Description=__SLUG__ __DESC__ (__ENV__)

[Service]
Type=simple
WorkingDirectory=__RUN__
ExecStart=__PHP__ artisan __CMD__
Restart=always
RestartSec=5
# Let a worker finish its current job on stop/restart.
KillSignal=SIGTERM
TimeoutStopSec=70
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

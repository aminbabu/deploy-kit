[Unit]
Description=__SLUG__ Laravel scheduler (__ENV__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__RUN__
ExecStart=__PHP__ artisan schedule:work
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
